# # HTTP server
# PORT=4000
# NODE_ENV=development

# # SQL Server connection
# DB_SERVER=localhost
# DB_PORT=1433
# DB_NAME=IVConnect
# DB_USER=sa
# # Must match the password used when the ivconnect-sql Docker container was created
# DB_PASSWORD=YourStrong!Passw0rd
# # true for local/dev containers using a self-signed certificate
# DB_TRUST_SERVER_CERTIFICATE=true

# # Signs and verifies login JWTs. Generate a real value with:
# # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# # Never commit a real value here — only in your local, gitignored .env.
# JWT_SECRET=replace-with-at-least-32-random-characters
# # How long an issued token stays valid (jsonwebtoken duration string).
# JWT_EXPIRES_IN=8h
# # AES-256-GCM key (32 bytes as 64 hex chars) used to encrypt PAN, contact number and
# # address fields before they're stored. Generate a real value with:
# # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# # Rotating this key makes all previously encrypted PII permanently undecryptable —
# # never regenerate it once real data has been written with it.
# PII_ENCRYPTION_KEY=
# CORS_ORIGIN=http://localhost:8080
# # Local folder generated payslip PDFs are written to. A cloud blob store is the real
# # production target; local disk is correct and sufficient for this phase.
# PAYSLIP_STORAGE_PATH=./generated-payslips
