# HTTP server
PORT=4000
NODE_ENV=development

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IVConnect
DB_USER=sa
# Must match the password used when the ivconnect-sql Docker container was created
DB_PASSWORD=YourStrong!Passw0rd
# true for local/dev containers using a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=true
